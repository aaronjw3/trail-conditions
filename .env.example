# Copy to .env and edit locally. Never commit your populated .env.
# Docker Compose reads .env automatically.
# For native Go and tests: set -a; source .env; set +a

# Required for the map. Paste your public pk. token here; never use an sk. token.
# Forecasts still work without a map token. Open-Meteo needs no API key.
MAPBOX_PUBLIC_TOKEN=

# Host port for the Docker database. Change if already occupied.
TRAIL_DB_PORT=55432

# Native Go and integration tests connect through the published host port.
# These are the local-development credentials configured in compose.yaml.
DATABASE_URL="postgres://trail:trail_local@127.0.0.1:${TRAIL_DB_PORT}/trail?sslmode=disable"
TEST_DATABASE_URL="${DATABASE_URL}"

# Native Go listener. Docker uses 0.0.0.0:8080 inside its container.
TRAIL_LISTEN_ADDR=127.0.0.1:8080
